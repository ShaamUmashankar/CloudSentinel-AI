# CloudSentinel AI Environment Configuration

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=cloudsentinel-secret-key-change-in-production
PORT=5000
DEBUG=True

# Database Configuration (SQLite default for local prototype)
DATABASE_PATH=data/cloudsentinel.db

# Machine Learning Anomaly Detection Configuration
ML_CONTAMINATION_RATE=0.08
ML_ANOMALY_THRESHOLD=0.65
ML_MODEL_PATH=models/isolation_forest.joblib

# RAG & Generative AI Configuration
# Options: gemini, openai, fallback
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
FAISS_INDEX_PATH=data/faiss_index.bin
KNOWLEDGE_BASE_DIR=data/knowledge_base

# Optional AWS Integration Settings (Demonstration / Cloud Extension)
AWS_ENABLED=False
AWS_REGION=us-east-1
AWS_CLOUDTRAIL_BUCKET=my-organization-cloudtrail-logs
AWS_DYNAMODB_TABLE=CloudSentinel-Incidents
AWS_KMS_KEY_ID=alias/cloudsentinel-encryption-key
AWS_LAMBDA_ARN=
AWS_REDSHIFT_CLUSTER=
